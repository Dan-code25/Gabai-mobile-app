{
  "expo": {
    "name": "GabAI",
    "slug": "GabayAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gabai-logo.png",
    "scheme": "gabai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FF8000",
        "foregroundImage": "./assets/images/gabai-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.GabayAI"
    },
    "web": {
      "favicon": "./assets/images/gabai-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-router",
      "expo-font"
    ]
  }
}
